          "name": "Create an API key or web integration token",
          "request": {
            "name": "Create an API key or web integration token",
            "description": {
              "content": "Issues a Truora API key. With key_type=backend the returned JWT authenticates server-to-server API calls; with key_type=web it issues a short-lived web integration token used to launch a Digital Identity process in the browser or WhatsApp flow.",
